# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# ── Strava (obrigatório) ──
# App criado em https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Refresh token inicial. Depois do primeiro login em /api/auth/strava/callback,
# o token renovado fica no Redis (produção) ou em data/strava-token.json (dev).
STRAVA_REFRESH_TOKEN=
# URL pública do site, usada no retorno do OAuth (ex.: https://seu-site.vercel.app)
STRAVA_REDIRECT_URI=
NEXT_PUBLIC_APP_URL=

# ── Redis / Upstash (obrigatório em produção) ──
# Guarda token do Strava, plano COROS, provas e previsões.
# Use um dos pares (a Vercel KV cria o primeiro automaticamente).
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Administração (obrigatório em produção) ──
# Sem ele, as rotas que gravam dados ficam fechadas em produção.
# Enviado no cabeçalho x-admin-secret ou Authorization: Bearer.
ADMIN_SECRET=

# ── COROS ──
# A Vercel manda este segredo nas chamadas do cron diário (vercel.json). Gere um valor aleatório.
CRON_SECRET=
# Opcionais: servidor MCP e endereço de retorno do login (o padrão é o domínio do site).
COROS_MCP_URL=
COROS_REDIRECT_URI=
# Opcional: script de importação manual
COROS_IMPORT_BASE_URL=
